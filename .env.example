# 환경 설정 예시 파일 (git 커밋 대상)
# 사용법: cp .env.example .env 로 복사한 뒤 .env 를 수정하세요. (.env 는 git 에서 제외됨)

# `docker compose up -d` 시 기본으로 띄울 프로파일 (쉼표로 여러 개 지정 가능)
#   desktop | desktop-full | simulation | native
COMPOSE_PROFILES=desktop-full

# 같은 값을 쓰는 노드끼리만 통신 (0~101)
ROS_DOMAIN_ID=0

# noVNC (브라우저 GUI)
NOVNC_PORT=8080
DISPLAY_WIDTH=1600
DISPLAY_HEIGHT=900

# native 프로파일에서 빌드할 메타패키지: desktop | desktop-full | simulation | perception
NATIVE_VARIANT=desktop-full
